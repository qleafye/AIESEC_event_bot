# ===========================
# AIESEC Event Bot — .env
# ===========================
# Скопируйте этот файл как .env и заполните значения.
#
# ⚠️ Здесь только то, что бот НЕ МОЖЕТ спросить у вас в Telegram: токены, доступы, пути на
# диске. ВСЁ ОСТАЛЬНОЕ (тексты, тарифы, вопросы анкеты, тайминги, тумблеры модулей) настраивается
# ИЗНУТРИ бота — «⚙️ Настройки» в /admin — без правки этого файла и без рестарта. Правило
# владельца от 18.08.2026 (Phase 14, CFG-01): .env трогает только тот, кто разворачивает сервер;
# полная таблица «что где живёт и почему» — README.md, раздел «Что в .env и почему».

# ---------------------------
# Telegram
# ---------------------------

# Токен бота от @BotFather
BOT_TOKEN=123456789:ABCDefGHIjkLLmnoPQRstuVWxyz

# Telegram ID администраторов (JSON-список). Это BOOTSTRAP-суперадмины: полный доступ всегда,
# снять их можно только правкой этого файла и рестартом. Остальных менеджеров с ограниченным
# доступом заводит сам бот — «👥 Роли и доступы» в /admin, без .env.
# Узнать свой ID: отправьте /start боту @userinfobot
ADMIN_IDS=[12345678, 87654321]

# ---------------------------
# Прокси (опционально, если Telegram API недоступен напрямую)
# ---------------------------
# Форматы: http://user:pass@host:port или socks5://user:pass@host:port
# (aiohttp-socks уже стоит зависимостью — можно указать socks5:// эндпоинт напрямую,
# без промежуточного HTTP-прокси типа privoxy)
# PROXY_URL=socks5://user:pass@1.2.3.4:1080

# Резервный прокси (опционально) — при обрыве PROXY_URL бот автоматически переключается
# на этот канал (без рестарта), остаётся на нём (sticky) и периодически пробует вернуться на
# основной (тайминг — «⚙️ Настройки → 🔧 Система», см. ниже).
# ⚠️ ВАЖНО: резерв спасает только если он ФИЗИЧЕСКИ независим от основного — другой
# сервер/туннель/канал. Второй порт того же VPS или второй privoxy поверх того же
# ssh-туннеля упадёт ОДНОВРЕМЕННО с основным и ничего не даст.
# Формат такой же, как у PROXY_URL. Пусто = резерв выключен, поведение как раньше.
#
# Третий вариант линка — БЕЗ прокси, но на другой адрес Bot API:
#   api:https://tg.alekseev.info
# Это Cloudflare Worker на своём домене, который проксирует api.telegram.org и доступен из
# РФ напрямую (без туннеля/VPS). Такой резерв не делит инфраструктуру с основным прокси —
# лёг хостер, лёг туннель — бот сам переключится на Worker (и вернётся, когда основной оживёт).
# Worker пропускает ТОЛЬКО токены из своего allow-list (секрет TOKEN_HASHES = SHA-256 от
# "bot<token>", через запятую) — для нового бота хэш нужно добавить в настройках Worker'а.
# Резервов может быть НЕСКОЛЬКО — через запятую, порядок = приоритет: бот идёт по списку
# и возвращается к основному, когда тот оживает. Рекомендуемая схема (три независимых пути:
# свой туннель, второй VPS, Cloudflare Worker):
#   PROXY_URL=http://host.docker.internal:8118
#   PROXY_URL_BACKUP=http://user:pass@second-vps:port, api:https://tg.alekseev.info
# «api:» работает и в PROXY_URL (тогда Worker — основной путь, прокси — резерв).
PROXY_URL_BACKUP=

# ---------------------------
# Google Sheets (опционально)
# ---------------------------
# Если не заполнить — бот работает только с локальной SQLite БД.
# Подробная инструкция по настройке — в README.md

# ID таблицы из URL: https://docs.google.com/spreadsheets/d/ВОТ_ЭТОТ_ID/edit
GOOGLE_SHEET_ID=

# Путь к JSON-ключу сервисного аккаунта (относительно корня проекта)
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# ---------------------------
# База данных / логи
# ---------------------------
# Путь к файлу SQLite (относительно корня проекта, если volume не смонтирован иначе)
DB_PATH=data/forum.db

# Уровень файла logs/bot.log: DEBUG | INFO | WARNING | ERROR.
# docker logs всегда только WARNING+ (чтобы не срало). Полный лог — в файле.
LOG_LEVEL=INFO

# ---------------------------
# Nextcloud — резюме-файлы в облако (опционально)
# ---------------------------
# Если пусто — фича выключена: рега работает как раньше, резюме остаётся file_id в боте.
# Заполнить — резюме (файл ИЛИ текст) льётся в Nextcloud, в таблицу пишется deep-ссылка.
#
# МОДЕЛЬ ШАРИНГА (важно): пофайловых share-ссылок БОЛЬШЕ НЕТ. Ссылки в таблице — это
# deep-links в ОДНУ ручную публичную шару папки resumes. Пароль ставится ОДИН РАЗ на самой
# шаре папки в UI Nextcloud (NEXTCLOUD_SHARE_PASSWORD код больше НЕ шлёт). По deep-ссылке
# Nextcloud спросит пароль папки 1 раз за сессию, дальше отдаёт файл напрямую.
# Как получить токен: создай публичную шару папки resumes → в ссылке /s/XXXX часть XXXX
# и есть NEXTCLOUD_FOLDER_SHARE_TOKEN.
#
# РЕКОМЕНДОВАНО (бот и Nextcloud в docker на одном хосте — наш случай):
# Подключи бот-контейнер к внутренней docker-сети Nextcloud (напр. nextcloud_internal)
# и ходи к app-контейнеру НАПРЯМУЮ по простому HTTP, минуя Caddy/TLS:
#   NEXTCLOUD_BASE_URL=http://nextcloud-app:80
#   NEXTCLOUD_WEBDAV_URL=http://nextcloud-app:80/remote.php/dav/files/<user>/
# Трафик не выходит из docker → ни hairpin/NAT, ни self-signed TLS. VERIFY_TLS/CA_BUNDLE
# при http не участвуют (нечего проверять).
# Имя сети/сервиса — из compose Nextcloud (docker network ls | grep nextcloud).
#
# ВАЖНО про WEBDAV_URL: это ПОЛНЫЙ dav-эндпоинт пользователя, оканчивается на
# /remote.php/dav/files/<user>/ — НЕ просто /remote.php/ (это не WebDAV-корень, PUT сломается).
#
# На стороне Nextcloud (occ, <ncf> = имя APP-контейнера, не Caddy):
#   1) внутренний хост в trusted_domains, иначе запросы бота = «untrusted domain»:
#      docker exec -u www-data <ncf> php occ config:system:set trusted_domains 3 --value="nextcloud-app"
#   2) чтобы public share-ссылки были ПУБЛИЧНЫМИ, а не прилипли к внутреннему хосту:
#      docker exec -u www-data <ncf> php occ config:system:set overwritehost --value="91.223.28.229:8443"
#      docker exec -u www-data <ncf> php occ config:system:set overwriteprotocol --value="https"
#      docker exec -u www-data <ncf> php occ config:system:set overwrite.cli.url --value="https://91.223.28.229:8443"
#   Купишь домен → сюда пойдёт https://cloud.твойдомен вместо IP.
#
# Бот на ДРУГОМ хосте/VPS (не тот же сервер) — hairpin не грозит: ходи на внешний
# https://91.223.28.229:8443, WEBDAV .../remote.php/dav/files/<user>/. Сертификат
# self-signed → положи его PEM (или CA, которым он подписан) рядом с ботом и укажи
# NEXTCLOUD_CA_BUNDLE — проверка останется включённой. VERIFY_TLS=false — только как
# осознанный аварийный режим: каждый PUT несёт app-password и само резюме, без проверки
# сертификата их перехватит любой MITM на пути.

# WebDAV-эндпоинт пользователя бота (обычно BASE + /remote.php/dav/files/<user>/)
NEXTCLOUD_WEBDAV_URL=
# Логин пользователя-бота в Nextcloud (не admin!)
NEXTCLOUD_USER=aiesec-bot
# App-password этого пользователя (Settings → Security → Create new app password)
NEXTCLOUD_APP_PASS=
# Папка внутри пользователя, куда складывать резюме (совпадает с расшаренной папкой)
NEXTCLOUD_FOLDER=resumes
# УСТАРЕЛО: код больше НЕ шлёт этот пароль. Пароль ставится вручную на самой шаре папки в UI.
NEXTCLOUD_SHARE_PASSWORD=
# Публичный адрес для сборки ссылок, напр. https://91.223.28.229:8443
NEXTCLOUD_PUBLIC_URL=
# Токен XXXX из ссылки ручной публичной шары папки resumes: /s/XXXX
NEXTCLOUD_FOLDER_SHARE_TOKEN=
# Проверять TLS-сертификат WebDAV-адреса. По умолчанию true (рекомендуется оставить).
# Домен + Let's Encrypt → ничего не трогать. Self-signed → оставить true и указать CA_BUNDLE.
# false — отключает проверку совсем; только если понимаешь, что делаешь.
NEXTCLOUD_VERIFY_TLS=true
# Путь к PEM-файлу (CA или сам сертификат сервера) для self-signed Nextcloud. Пусто —
# системное хранилище доверия. В docker файл нужно примонтировать внутрь контейнера
# (например ./nextcloud-ca.pem:/app/nextcloud-ca.pem:ro) и указать путь внутри контейнера.
NEXTCLOUD_CA_BUNDLE=

# ===========================================================================
# Дашборд статистики (Phase 15, D-05/D-18)
# ===========================================================================
# Адрес дашборда стека, напр. https://yl26.alekseev.info; пусто = кнопка
# «🌐 Открыть дашборд» на экране 📊 Статистика скрыта.
DASHBOARD_PUBLIC_URL=

# Секрет подписи cookie-сессии дашборда (D-09) — длинная случайная строка, СВОЙ на каждый
# стек (не переиспользовать между YouLead/RusCo). Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Смена значения разлогинивает всех сразу — все подписанные ранее cookie перестают проходить
# проверку.
DASHBOARD_SESSION_SECRET=

# Username бота ЭТОГО стека (без @) для Telegram Login Widget, напр. YouLead_bot (D-04).
# Домен дашборда должен быть привязан к этому боту в BotFather (/setdomain).
DASHBOARD_BOT_USERNAME=

# ===========================================================================
# Разовый первый запуск (bootstrap)
# ===========================================================================
# Поля ниже читаются ТОЛЬКО при первом старте, чтобы засеять соответствующую настройку внутри
# бота — дальше .env для них НЕ читается. Оставьте их пустыми/по умолчанию, если разворачиваете
# бот с нуля и готовы настроить всё в первые минуты после первого запуска из /admin →
# ⚙️ Настройки. Подробности — README.md, «Что в .env и почему».

# Имя основной вкладки Google-таблицы (Phase 14: DEPRECATED как повседневная настройка).
# Разово переносится в «⚙️ Настройки → 📄 Вкладки таблицы» (bot_settings.main_sheet_tab) с
# WARNING в лог. Пусто — бот один раз возьмёт первую вкладку по позиции (аварийный fallback,
# будет громко предупреждать в Telegram и логах, пока вкладка не задана — из .env ИЛИ из бота).
GOOGLE_SHEET_TAB=

# Тайминги прокси (Phase 14: DEPRECATED как повседневная настройка). Разово переносятся в
# «⚙️ Настройки → 🔧 Система» — правка ТАМ требует рестарта бота, чтобы примениться (оба
# значения читаются один раз при старте, конструктор FailoverAiohttpSession).
PROXY_RECHECK_SECONDS=600
PROXY_CONNECT_TIMEOUT=5

# Города мероприятия (Phase 07.1, CITY-01). Формат:
# code|подпись|база_вкладки;code|подпись|база_вкладки;...  Записи через «;».
# ПУСТАЯ база вкладки = город работает на легаси-вкладках (GOOGLE_SHEET_TAB,
# short_sheet_tab, party_sheet_tab, «Незавершённые») — поэтому у msk она пустая,
# живые данные не переезжают. Если не заполнить — используются те же 3 города по умолчанию.
# С Phase 14 это ТОЛЬКО seed: читается один раз, когда таблица cities пуста. Дальше города
# правятся в боте: «⚙️ Настройки → 🏙 Города» (правки .env после первого старта игнорируются).
EVENT_CITIES=msk|Москва, 30-31 октября|;spb|Санкт-Петербург, 3 октября|СПб;tyumen|Тюмень, 3 октября|Тюмень
# Код города (из EVENT_CITIES), в который резолвится пустой event_city (см. cities.normalize_city).
EVENT_CITY_DEFAULT=msk
